# Este es un archivo de ejemplo para las variables de entorno del backend.
# Para configurar tu entorno local, copia este archivo a uno nuevo llamado `.env`
# y rellena los valores según sea necesario.

# Configuración de la Base de Datos PostgreSQL
# Estos valores deben coincidir con los definidos en el archivo docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ecommerce_db

# Configuración de la Aplicación
# El puerto en el que se ejecutará la API del backend.
API_PORT=3001

# Seguridad
# Una clave secreta y compleja para firmar los JSON Web Tokens (JWT).
# ¡IMPORTANTE! Cambia este valor por uno propio y mantenlo en secreto.
JWT_SECRET=a-secure-and-random-jwt-secret-key-that-should-be-changed